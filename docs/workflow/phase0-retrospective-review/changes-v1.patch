+    "print(f\"  Max gap        : {df['Gap'].max():.2e}\")\n",
+    "print(f\"  Total time     : {df['Time (s)'].sum():.1f}s\")\n",
+    "print(f\"  Solver(s)      : {set(df['Solver'])}\")"
+   ]
+  },
+  {
+   "cell_type": "markdown",
+   "metadata": {},
+   "source": [
+    "## 5. 密钥率阈值验证\n",
+    "\n",
+    "BB84 理论阈值 (f_ec=1.0, Shor-Preskill): $e^* \\approx 11.00\\%$。\n",
+    "WLC SDP 在 11% 附近应给出接近零的密钥率。\n"
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": null,
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "THRESHOLD_QBERS = np.linspace(0.10, 0.115, 7)\n",
+    "\n",
+    "print(\"Near-threshold behavior (f_ec=1.0):\")\n",
+    "print(f\"{'QBER':>8}  {'WLC':>12}  {'SP':>12}  {'|diff|':>10}\")\n",
+    "for qber in THRESHOLD_QBERS:\n",
+    "    proto = build_bb84_protocol(qber=qber)\n",
+    "    obs = {\"qber_Z\": qber, \"qber_X\": qber, \"p_sift\": 0.5}\n",
+    "    res = wlc_key_rate(proto, obs, f_ec=1.0)\n",
+    "    sp = shor_preskill_rate(qber, f_ec=1.0)\n",
+    "    print(f\"  {qber*100:5.2f}%  {res.key_rate:+12.6f}  {sp:+12.6f}  {abs(res.key_rate-sp):10.2e}\")"
+   ]
+  },
+  {
+   "cell_type": "markdown",
+   "metadata": {},
+   "source": [
+    "## 6. 面部缩减测试 (Facial Reduction)\n",
+    "\n",
+    "高 QBER 下 (e.g. QBER=10%)，最优态接近秩亏缺(rank-deficient)。\n",
+    "facial.py 的 `reduce_problem` 提供 Tikhonov 正则化回退，保证 SDP 可解性。\n"
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": null,
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "from qkdx.numerics.facial import reduce_problem\n",
+    "\n",
+    "QBER_HIGH = 0.10\n",
+    "proto_high = build_bb84_protocol(qber=QBER_HIGH)\n",
+    "obs_high = {\"qber_Z\": QBER_HIGH, \"qber_X\": QBER_HIGH, \"p_sift\": 0.5}\n",
+    "\n",
+    "res_high = wlc_key_rate(proto_high, obs_high, f_ec=1.0)\n",
+    "sp_high = shor_preskill_rate(QBER_HIGH, f_ec=1.0)\n",
+    "\n",
+    "print(f\"QBER={QBER_HIGH*100:.0f}% (near-threshold):\")\n",
