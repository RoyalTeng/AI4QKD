+    protocol: MSEBProtocol,
+    observations: Mapping[str, float],
+    *,
+    solver: str = "MOSEK",
+    ...
+) -> float:
+    if protocol.scope_tag == "out_of_scope":
+        raise OutOfScopeError(
+            f"wlc_key_rate refuses out_of_scope protocol "
+            f"{protocol.name!r}: {protocol.scope_reason}"
