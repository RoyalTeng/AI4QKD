+| 20 | 0.400 | +2.839e-03 | 1.452e-02 | 0.0363 |
+| 40 | 0.400 | +1.068e-03 | 5.517e-03 | 0.0364 |
+| 60 | 0.400 | +4.027e-04 | 2.097e-03 | 0.0365 |
