+        expected = (1 - gamma) ** 2 * 1.0 * (1 - hQ)
+        assert bb84_qubit_preEC_entropy(p_depol=0.01, eta_det=1.0, gamma=gamma) == pytest.approx(expected, rel=1e-12)
