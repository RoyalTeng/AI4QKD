++    """Lo-Ma-Chen 2005 Fig.3 参数对齐."""
++    assert LMC_2005_FIG3.eta_detector == 0.145
++    assert LMC_2005_FIG3.p_dark == 8.5e-7
++    assert LMC_2005_FIG3.e_misalignment == 0.033
