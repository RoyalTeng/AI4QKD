++    DeviceProfile, IDEAL, LMC_2005_FIG3, TYPICAL_S23,
++    sweep_decoy_bb84_distance, sweep_decoy_bb84_mu_distance,
++    compare_profiles_at_distance,
++)
++from qkdx.sweeps.pareto import count_points
++
++
++# ---- DeviceProfile data integrity --------------------------------------------
++
