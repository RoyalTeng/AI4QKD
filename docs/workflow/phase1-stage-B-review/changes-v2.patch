+        "qber_X": lambda _p: _gamma_qber_X(),
+        "p_sift": lambda _p: np.eye(4, dtype=np.complex128) * p_sift,
+        "_conditional_alice_bob": conditional_override,
+        "_cond_dim": lambda _p: 4,
