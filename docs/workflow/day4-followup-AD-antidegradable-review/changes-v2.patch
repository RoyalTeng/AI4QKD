++    ax.set_xlabel("γ")
++    ax.set_ylabel(r"log_neg / $E_R^{PPT}$")
++    ax.set_title("log_neg looseness vs tighter SDP UB")
++    ax.set_xlim(0, 1)
++    ax.set_ylim(1.0, 2.4)
++    ax.legend(loc="lower right", fontsize=9)
