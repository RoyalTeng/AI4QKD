+            assert rho[3, 3].real == pytest.approx(eta / 2, abs=1e-12)
+            # Off-diagonal: rho[0,3] = rho[3,0] = √η/2
+            assert rho[0, 3].real == pytest.approx(eta**0.5 / 2, abs=1e-12)
