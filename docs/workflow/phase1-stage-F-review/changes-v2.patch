++@pytest.mark.parametrize("N", [10**6, 10**8, 10**10])
++def test_bb84_finite_key_length_monotone_in_N(N: int) -> None:
++    """Per-signal rate monotonically increases with N (less finite-size penalty)."""
++    m = int(0.1 * N)
