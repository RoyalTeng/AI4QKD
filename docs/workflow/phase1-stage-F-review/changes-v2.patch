++    asymptotic = 1.0 - 2.0 * _h(e)  # Shor-Preskill at f_EC=1
++    # Expect finite-size penalty small at N=1e10
++    assert abs(per_signal - asymptotic) < 0.01, (
++        f"per_signal={per_signal:.6f}, asymptotic={asymptotic:.6f}"
++    )
