++# ---- BB84 finite-key length (Eq. 19) -----------------------------------------
++
++def test_bb84_finite_key_length_asymptotic_convergence() -> None:
++    """As n, m → ∞, ℓ/n → 1 - 2h(e) (Shor-Preskill at e_x = e_z)."""
++    e = 0.05
